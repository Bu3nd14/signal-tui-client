# WAHA credentials — copy this file to `.env` and fill in the real values.
# WAHA generates the API key + dashboard/swagger passwords on its first start
# and requires them afterwards (REST calls need the X-Api-Key header).
#
#   cp .env.example .env
#
# Tip: after `docker compose up -d`, open the WAHA dashboard logs for the
# exact values, or read them from the container env:
#   docker exec signal-tui-whatsapp env | grep WAHA_API_KEY
#
# The Python client (backends/config.py) reads WAHA_API_KEY from this file too,
# so it can authenticate without you exporting WHATSAPP_API_KEY manually.
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
