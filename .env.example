# WAHA credentials. `./install.sh --whatsapp` creates `.env` automatically,
# generates secure values for blank credentials, and preserves existing values.
# For a manual Docker Compose setup, copy this file and fill in the values.
#
#   cp .env.example .env
#
# To inspect the API key used by a running container:
#   docker exec signal-tui-whatsapp env | grep WAHA_API_KEY
#
# The Python client (backends/config.py) reads WAHA_API_KEY from this file too,
# so it can authenticate without you exporting WHATSAPP_API_KEY manually.
# The installer selects `:arm` on ARM hosts and `:latest` on x86_64.
WAHA_IMAGE=
WAHA_API_KEY=
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=

# Port on which the Python client serves the WAHA webhook endpoint (/webhook).
# WAHA_WEBHOOK_URL in docker-compose.yml (default 8088) funnels incoming
# messages to this port, so both values must match.  Optional: default 8088.
CLIENT_WEBHOOK_PORT=8088

# ── WhatsApp startup bulk resync ──────────────────────────────────────────
# The Python client reads these four flags from the process environment or
# config.json (keys wa_resync_*), NOT from this .env file.  Export them in the
# process that runs the client, or put them in config.json.
# WA_RESYNC_DOWNLOAD_MEDIA=false  # true restores download+resolution (rollback)
# WA_RESYNC_MAX_CHATS=20          # 0 = unlimited; negative falls back to 20
# WA_RESYNC_LIMIT=30              # per-chat history limit (<=0 -> 30)
# WA_RESYNC_WORKERS=2             # concurrent fetch workers (<=0 -> 2)
# Full functional rollback (not bit-exact: the 0.5s stagger between batches
# remains): WA_RESYNC_DOWNLOAD_MEDIA=true, WA_RESYNC_LIMIT=50,
# WA_RESYNC_WORKERS=4, WA_RESYNC_MAX_CHATS=0.

# ── WhatsApp lazy media on chat open (S1) ─────────────────────────────────
# Like the WA_RESYNC_* flags these are read from the process environment or
# config.json (keys wa_lazy_media*), NOT from this .env file.
# Opening a chat fetches the history with downloadMedia=false; each media is
# downloaded from WAHA only when its bubble becomes visible (or the file is
# opened), one message at a time, then served from the local media dir.
# WA_LAZY_MEDIA=true               # false = rollback: chat open downloads the
#                                  # media of the whole window (pre-S1).
#                                  # Applies to web AND TUI (server.config).
# WA_LAZY_MEDIA_NEGATIVE_TTL_S=30  # seconds a failed media is not retried
#                                  # (0 disables; negative falls back to 30)
# Residual risk: resolving one message also downloads its QUOTED media on the
# WAHA side, which the client cannot disable.

# WAHA compose files used by launcher.py (README, "Extra compose files").
# WAHA_DOCKER_LIMITS=0 skips the CPU/RAM caps of docker-compose.resources.yml
# on every command (same as --no-docker-limits).  WAHA_COMPOSE_FILES lists
# extra files layered last, ":"-separated, relative to this directory.
# WAHA_DOCKER_LIMITS=0
# WAHA_COMPOSE_FILES=docker-compose.local.yml

# Signal auto-connect at boot.  Enabled by default only when a Signal user
# number is configured (SIGNAL_USER_NUMBER or config.json "user_number").
# Set SIGNAL_ENABLED=0 for a WhatsApp/Telegram-only deployment: the Signal
# backend stays registered but is not connected, so signal-cli is never
# started (no daemon/JAVA_HOME errors, no SSE retry noise).
# SIGNAL_ENABLED=0

# Telegram credentials — from https://my.telegram.org (API Development Tools).
# Copy this file to .env and fill in the real values when enabling Telegram.
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your_hash_here

# ── Gmail (web UI POC) ─────────────────────────────────────────────────────
# Setup guidato: python3 scripts/gmail_setup.py  (oppure ./install.sh --gmail)
# Accesso IMAP/SMTP con App Password Google (NO OAuth, NO Gmail API).
# Crea una App Password su https://myaccount.google.com/apppasswords e
# incollala qui: la password dell'account NON funziona con IMAP/SMTP.
# GMAIL_ADDRESS=user@gmail.com
# Preferisci un file con permessi 600 (fuori dal repo) o un credential helper:
# GMAIL_APP_PASSWORD_FILE=~/.config/signal-tui/gmail-app-password
# GMAIL_APP_PASSWORD_CMD=gpg --batch --quiet --decrypt ~/.config/signal-tui/gmail-app-password.gpg
# TPM2 (Linux, richiede /dev/tpmrm0 accessibile; usare percorso assoluto):
# GMAIL_APP_PASSWORD_CMD=systemd-creds decrypt --name=gmail-app-password /home/user/.config/signal-tui/gmail-app-password.cred -
# Fallback legacy (sconsigliato): GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Host/porte opzionali (default Gmail: IMAP SSL 993, SMTP STARTTLS 587).
# GMAIL_IMAP_HOST=imap.gmail.com
# GMAIL_IMAP_PORT=993
# GMAIL_SMTP_HOST=smtp.gmail.com
# GMAIL_SMTP_PORT=587
# Cartella predefinita e timeout socket in secondi (default: INBOX, 30).
# GMAIL_FOLDER=INBOX
# GMAIL_TIMEOUT_S=30

# ── Retention storico (bug #51) ────────────────────────────────────────────
# Messaggi conservati per contatto nel DB, tagliati a chiusura app.
# Default 300. 0 = disabilita il prune. Minimo forzato: 100 (deve restare
# sopra la finestra di re-fetch di 50). Nota: per Signal la storia oltre il
# cap NON è recuperabile (nessun re-fetch) — usa 0 o valori alti se ti serve
# un archivio completo.
# MESSAGE_RETENTION_PER_CONTACT=300
